# ── Supply-chain hardening ──
# Quarantine window — refuse to resolve any package version published less
# than 7 days ago. Most supply-chain attacks (typosquatting, account takeover)
# are detected by the community within hours; a 7-day buffer eliminates the
# majority of the risk.
#
# This is the client-side backstop. It fires at *resolution* (`npm install`,
# `npm update`) — in practice a human adding or bumping a package by hand — and
# never on `npm ci`, which installs exactly what the lockfile pins. Dependabot
# is quarantined upstream instead, by `cooldown: default-days: 7` in
# .github/dependabot.yml.
min-release-age=7

# NOTE: `ignore-scripts=true` is deliberately NOT set here, unlike other WR
# repos. This project depends on packages that need their install scripts to
# produce a working tree — `electron` and `electron-winstaller` download
# binaries, `keytar` builds a native module — and the root `postinstall` runs
# `electron-builder install-app-deps`. Turning scripts off would need each of
# those rebuilt explicitly afterwards, which is a deliberate migration with a
# full Linux + Windows build behind it, not a one-line config change.
#
# Do not add `audit-signatures` here either: it is a flag on the `npm audit`
# command, not a config key. npm warns "Unknown project config" and nothing
# about the install changes. Signature verification belongs in a CI step as
# `npm audit signatures`.
