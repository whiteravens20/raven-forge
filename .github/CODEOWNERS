# ── Code Owners ───────────────────────────────────────────────────────────────
# Auto-requests review from the listed owner on any PR touching these paths, and
# documents where the blast radius is largest.
#
# Do NOT turn on "Require review from Code Owners" in branch protection here.
# This is a one-maintainer repository and nobody can approve their own PR, so
# that setting would leave every PR unmergeable. The merge gate is CI — the
# required status checks on main and dev.
#
# Paths are checked most-specific to least-specific; last matching rule wins.

# Default: all files require owner review
#* @pavlojs

# ── CI/CD & supply chain ──────────────────────────────────────────────────────
# Any change to workflow files or Dependabot config is high-risk supply-chain.
/.github/ @pavlojs

# ── Packaging ─────────────────────────────────────────────────────────────────
# Controls what ends up inside a signed installer on someone else's machine.
/electron-builder.config.js @pavlojs
/package.json @pavlojs
/package-lock.json @pavlojs

# Maintainer scripts run as **root** during `dpkg -i`, and this one sets the
# setuid bit on chrome-sandbox. Highest-privilege file in the repository.
/build/ @pavlojs

# Build-time scripts that rewrite what ships: inject-build-ids.mjs edits
# compiled output in dist/, make-icons.cjs generates the installer artwork.
/scripts/ @pavlojs

# ── Trust boundary ────────────────────────────────────────────────────────────
# The preload is the entire bridge between the renderer and Node. Window options
# decide whether that bridge is the only one.
/src/preload/ @pavlojs
/src/main/window.ts @pavlojs
/src/main/ipc-handlers.ts @pavlojs
# The Content-Security-Policy, the permission policy and where a link may go.
/src/main/security.ts @pavlojs

# ── Content integrity ─────────────────────────────────────────────────────────
# Manifest signature verification and file hashing — the two things standing
# between a user and a backdoored jar.
/src/core/updater/manifest-verify.ts @pavlojs
/src/core/mods/integrity.ts @pavlojs
/src/shared/manifest-schema.ts @pavlojs

# ── Credentials ───────────────────────────────────────────────────────────────
# OAuth chain and the keychain-backed token store.
/src/core/auth/ @pavlojs

# ── Code execution ────────────────────────────────────────────────────────────
# Builds the argv the JVM is spawned with, and unpacks archives to disk.
/src/core/minecraft/game-launcher.ts @pavlojs
/src/core/minecraft/asset-downloader.ts @pavlojs
/src/core/util/zip-read.ts @pavlojs
/src/core/packs/mrpack.ts @pavlojs
# Puts a file the player picked on the game's class path.
/src/core/mods/local-mod.ts @pavlojs

# ── Egress ────────────────────────────────────────────────────────────────────
