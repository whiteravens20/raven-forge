{
  "name": "raven-forge-launcher",
  "productName": "Raven Forge Launcher",
  "version": "0.9.0",
  "description": "Custom Minecraft: Java Edition launcher with mod management, auto-sync, and server profiles",
  "author": {
    "name": "White Ravens",
    "email": "pavlojs@gmail.com",
    "url": "https://whiteravens.net"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/whiteravens20/raven-forge.git"
  },
  "main": "dist/main/index.js",
  "desktopName": "raven-forge-launcher.desktop",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,electron -c green,gray,blue \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json && node scripts/inject-build-ids.mjs",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder -c electron-builder.config.js",
    "dist:win": "npm run build && electron-builder -c electron-builder.config.js --win",
    "dist:linux": "npm run build && electron-builder -c electron-builder.config.js --linux",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "electron scripts/make-icons.cjs",
    "clean": "rimraf dist out",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "keytar": "^7.9.0",
    "socks": "^2.8.10",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.2.0",
    "concurrently": "^10.0.6",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.66.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "^5.0.9",
    "shell-quote": "1.11.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
